[package]
  cjc-version = "{{ cjc_version }}"
  compile-option = "--dy-std --cfg=\"${COMPILE_CONDITION_{{ module_name_upper }}}\""
  description = "CangjieUI Application"
  name = "{{ cangjie_package }}_local_test"
  output-type = "dynamic"
  src-dir = "."
  target-dir = ""
  version = "1.0.0"

[profile]
  [profile.build]
    incremental = true
    lto = ""
    [profile.build.combined]
      {{ cangjie_package }}_local_test = "dynamic"
  [profile.customized-option]
    debug = "-g -Woff all -Won apilevel-check"
    release = "--fast-math -O2 -s -Woff all -Won apilevel-check"
  [profile.test]
